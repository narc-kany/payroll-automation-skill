# Copy to .env and export into your shell (the app reads os.environ; it does not parse .env itself).
# Mock-safe defaults: the skill runs fully offline without any credentials.
LOG_LEVEL=INFO
HRIS_DB_URI=postgresql://payroll_ro:***@hris.internal:5432/hris
SMTP_RELAY=smtp-relay.acme-corp.example:587
ALLOWED_EMAIL_DOMAINS=acme-corp.example
PAYROLL_HITL_THRESHOLD=10000
PAYROLL_USE_LLM=0
# Optional LLM intent parsing / LLM judge (leave unset for deterministic rules + heuristic judge):
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
# OLLAMA_HOST=http://localhost:11434
# Recommended in production: pin the caller role instead of trusting the payload.
# MCP_FORCE_ROLE=HR_MANAGER
